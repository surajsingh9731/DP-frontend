{
  "name": "@sahmati/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "ng serve web --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build web --configuration production",
    "typecheck": "ng build web --configuration development",
    "test": "ng test web --watch=false",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.json\" \"*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.json\" \"*.mjs\" \"scripts/*.mjs\"",
    "ui:prepare": "node scripts/prepare-ux4g.mjs",
    "ui:check": "node scripts/prepare-ux4g.mjs --check",
    "prestart": "npm run ui:prepare",
    "prebuild": "npm run ui:prepare",
    "pretypecheck": "npm run ui:prepare",
    "pretest": "npm run ui:check",
    "prelint": "npm run ui:check"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@sahmati/contracts": "file:../backend/contracts",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "ux4g-web-components": "3.0.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
